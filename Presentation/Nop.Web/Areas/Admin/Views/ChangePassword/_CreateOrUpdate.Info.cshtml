@model ChangePasswordModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="OldPassword" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="OldPassword" asp-required="true" />
            <span asp-validation-for="OldPassword"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="NewPassword" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="NewPassword" asp-required="true" />
            <span asp-validation-for="NewPassword"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="ConfirmNewPassword" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="ConfirmNewPassword" asp-required="true" />
            <span asp-validation-for="ConfirmNewPassword"></span>
        </div>
    </div>
</div>