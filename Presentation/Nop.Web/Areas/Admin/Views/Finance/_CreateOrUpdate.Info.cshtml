@model FinanceModel

<div class="card-body">    
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="ApplicantId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="ApplicantId" asp-items="Model.AvailableApplicants" asp-required="true" />
            <span asp-validation-for="ApplicantId"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="RecordTypeId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="RecordTypeId" asp-items="Model.AvailableRecordTypes" asp-required="true" />
            <span asp-validation-for="RecordTypeId"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="BankName" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="BankName" asp-required="true" />
            <span asp-validation-for="BankName"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="AccountMask" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="AccountMask" asp-required="true" />
            <span asp-validation-for="AccountMask"></span>
        </div>
    </div>    
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Currency" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Currency" />
            <span asp-validation-for="Currency"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PeriodStart" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="PeriodStart" />
            <span asp-validation-for="PeriodStart"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PeriodEnd" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="PeriodEnd" />
            <span asp-validation-for="PeriodEnd"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="AvgBalance" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="AvgBalance" />
            <span asp-validation-for="AvgBalance"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="AssetTypeId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="AssetTypeId" asp-items="Model.AvailableAssetTypes" asp-required="true" />
            <span asp-validation-for="AssetTypeId"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Amount" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Amount" />
            <span asp-validation-for="Amount"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Notes" />
        </div>
        <div class="col-md-9">
            <nop-textarea asp-for="Notes" />
            <span asp-validation-for="Notes"></span>
        </div>
    </div>
    @if (Model.Id > 0)
    {
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="CreatedAt" />
            </div>
            <div class="col-md-9">
                <div class="form-text-row">@Model.CreatedAt</div>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="CreatedBy" />
            </div>
            <div class="col-md-9">
                <div class="form-text-row">@Model.CreatedBy</div>
            </div>
        </div>
        if (Model.UpdatedAt.HasValue)
        {
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="UpdatedAt" />
                </div>
                <div class="col-md-9">
                    <div class="form-text-row">@Model.UpdatedAt</div>
                </div>
            </div>
        }
        if (!string.IsNullOrEmpty(Model.UpdatedBy))
        {
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="UpdatedBy" />
                </div>
                <div class="col-md-9">
                    <div class="form-text-row">@Model.UpdatedBy</div>
                </div>
            </div>
        }
    }   
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DocumentId" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DocumentId" />
            <span asp-validation-for="DocumentId"></span>
        </div>
    </div>
</div>