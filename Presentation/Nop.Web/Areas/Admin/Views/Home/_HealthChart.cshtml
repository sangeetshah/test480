@model ProfileModel

<div class="col-md-4 health-pie-chart" style="display: none; max-width: 30% !important;">
    <div class="card card-info">
        <div class="card-header clearfix" style="background-color: #ffffff;">
            <div class="float-left" style="color: #000000;">Health</div>
        </div>
        <div class="card-body">
            <canvas id="health-chart" height="300"></canvas>
        </div>
    </div>
</div>

<script>
    var healthCtx = document.getElementById('health-chart').getContext('2d');
    var healthChart;

    $("#generate-chart").click(function () {
        var applicantId = $("#ApplicantId").val();

        $.ajax({
            url: '@Url.Action("GetHealthCompletionPercentage", "Health", new { area = "Admin" })',
            type: 'POST',
            data: {
                applicantId: applicantId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (data) {
                $('.health-pie-chart').css("display", "block");

                if (healthChart) {
                    healthChart.destroy();
                }

                healthChart = new Chart(healthCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Filled', 'Empty'],
                        datasets: [{
                            data: [data.Filled, data.Empty],
                            backgroundColor: ['#4CAF50', '#f44336']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                            }
                        }
                    }
                });
            }
        });
    });
</script>