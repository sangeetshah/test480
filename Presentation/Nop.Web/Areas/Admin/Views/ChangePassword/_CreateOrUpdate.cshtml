@model ChangePasswordModel

@{
    const string hideInfoBlockAttributeName = "ChangePasswordPage.HideInfoBlock";
    var customer = await workContext.GetCurrentCustomerAsync();
    var hideInfoBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideInfoBlockAttributeName);
}

<div asp-validation-summary="All"></div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <nop-cards id="change-password-cards">
                <nop-card asp-name="change-password-info" asp-icon="fas fa-info" asp-title="@T("Admin.ChangePassword.Info")" asp-hide-block-attribute-name="@hideInfoBlockAttributeName" asp-hide="@hideInfoBlock" asp-advanced="false">@await Html.PartialAsync("_CreateOrUpdate.Info", Model)</nop-card>
            </nop-cards>
        </div>
    </div>
</section>