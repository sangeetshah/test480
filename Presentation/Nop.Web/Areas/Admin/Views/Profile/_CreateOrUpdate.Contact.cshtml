    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Mobile2" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Mobile2" />
            <span asp-validation-for="Mobile2"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="WhtasppMobile" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="WhtasppMobile" />
            <span asp-validation-for="WhtasppMobile"></span>
        </div>
    </div>    
