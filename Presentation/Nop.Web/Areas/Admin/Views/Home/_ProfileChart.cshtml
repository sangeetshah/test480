@model ProfileModel

<div class="col-md-4 profile-pie-chart" style="display: none; max-width: 30% !important;">
    <div class="card card-info">
        <div class="card-header clearfix" style="background-color: #ffffff;">
            <div class="float-left" style="color: #000000;">Profile</div>
        </div>
        <div class="card-body">
            <canvas id="profile-chart" height="300"></canvas>
        </div>
    </div>
</div>

<script>
    var profileCtx = document.getElementById('profile-chart').getContext('2d');
    var profileChart;

    $("#generate-chart").click(function () {
        var applicantId = $("#ApplicantId").val();

        $.ajax({
            url: '@Url.Action("GetProfileCompletionPercentage", "Profile", new { area = "Admin" })',
            type: 'POST',
            data: {
                applicantId: applicantId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (data) {
                $('.profile-pie-chart').css("display", "block");

                if (profileChart) {
                    profileChart.destroy();
                }

                profileChart = new Chart(profileCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Filled', 'Empty'],
                        datasets: [{
                            data: [data.Filled.toFixed(2), data.Empty.toFixed(2)],
                            backgroundColor: ['#4CAF50', '#E0E0E0']
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                            },
                            datalabels: {
                                color: 'black',       // Label color
                                font: {
                                    weight: 'bold',  // Bold text
                                    size: 12         // (Optional) make it a bit bigger
                                },
                                formatter: function(value) {
                                    return value + '%'; // Show percentage sign
                                }
                            }
                        }                        
                    },
                    plugins: [ChartDataLabels]
                });
            }
        });
    });
</script>