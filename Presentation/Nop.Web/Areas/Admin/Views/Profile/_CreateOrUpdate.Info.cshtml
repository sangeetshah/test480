@model ProfileModel

<div class="card-body">    
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="ApplicantId" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="ApplicantId" asp-required="true" />
            <span asp-validation-for="ApplicantId"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="GivenName" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="GivenName" />
            <span asp-validation-for="GivenName"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="FamilyName" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="FamilyName" />
            <span asp-validation-for="FamilyName"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DateOfBirth" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DateOfBirth" />
            <span asp-validation-for="DateOfBirth"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="GenderCode" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="GenderCode" asp-items="Model.AvailableGenders" asp-required="true" />
            <span asp-validation-for="GenderCode"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PrimaryCitizenship" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="PrimaryCitizenship" />
            <span asp-validation-for="PrimaryCitizenship"></span>
        </div>
    </div>    
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="MaritalStatusCode" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="MaritalStatusCode" />
            <span asp-validation-for="MaritalStatusCode"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="HasSponsor" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="HasSponsor" />
            <span asp-validation-for="HasSponsor"></span>
        </div>
    </div>
    @if (Model.Id > 0)
    {
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="CreatedAt" />
            </div>
            <div class="col-md-9">
                <div class="form-text-row">@Model.CreatedAt</div>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="CreatedBy" />
            </div>
            <div class="col-md-9">
                <div class="form-text-row">@Model.CreatedBy</div>
            </div>
        </div>
        @if (Model.UpdatedAt.HasValue)
        {
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="UpdatedAt" />
                </div>
                <div class="col-md-9">
                    <div class="form-text-row">@Model.UpdatedAt</div>
                </div>
            </div>        
        }
        @if (!string.IsNullOrEmpty(Model.UpdatedBy))
        {
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="UpdatedBy" />
                </div>
                <div class="col-md-9">
                    <div class="form-text-row">@Model.UpdatedBy</div>
                </div>
            </div>
        }
    }
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="AadharNo" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="AadharNo" />
            <span asp-validation-for="AadharNo"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PhotoId" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="PhotoId" />
            <span asp-validation-for="PhotoId"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="ResumeId" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="ResumeId" />
            <span asp-validation-for="ResumeId"></span>
        </div>
    </div>  
</div>